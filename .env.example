# Copy this file to .env and fill in the key(s) for whichever --master-provider you use.
# rove loads .env automatically on import (see rove/__init__.py) — no need to `set`/`export`
# anything yourself.

# --master-provider anthropic
ANTHROPIC_API_KEY=

# --master-provider openai
OPENAI_API_KEY=

# --master-provider local (Ollama, LM Studio, vLLM, etc. — OpenAI-compatible)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=
# ^ usually unneeded for a real local install (Ollama ignores it); set this if your
# endpoint is a remote/hosted Ollama-compatible instance that requires auth.

# --master-provider nvidia (NVIDIA's hosted NIM catalog — also OpenAI-compatible)
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --master-provider openrouter (OpenRouter's proxy catalog — also OpenAI-compatible)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
